# Optional providers. Without either key the agent runs at the deterministic floor.
ANTHROPIC_API_KEY=
# BLADE_REVIEW_MODEL=claude-sonnet-4-5

# OpenRouter alternative. When this is the only configured key it is auto-selected.
OPENROUTER_API_KEY=
# BLADE_REVIEW_PROVIDER=openrouter
# BLADE_REVIEW_MODEL=openai/gpt-4o-mini
# BLADE_REVIEW_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=Blade PR Review Agent

# GitHub Actions: store API keys as repository secrets and provider/model as
# repository variables. Local .env files are not available to hosted runners.

# Evaluation gates. Remote providers default to 0.50 correct-approval recall
# and 0.75 automatic decision coverage; the offline control does not enforce them.
EVAL_FALSE_APPROVE_BUDGET=0
# EVAL_MIN_CORRECT_APPROVAL_RATE=0.50
# EVAL_MIN_DECISION_COVERAGE=0.75
